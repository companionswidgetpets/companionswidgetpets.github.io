---
/**
 * Every page's shell: metadata for search engines and link previews, the Smart App
 * Banner, structured data, fonts, the top bar and the footer.
 */
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { app, absolute } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Set for the home page, which has its own title and hero top bar. */
  home?: boolean;
  /** Absolute URL of the social preview picture; the default card otherwise. */
  image?: string;
  type?: 'website' | 'article';
  /** Extra JSON-LD objects for this page. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  published?: string;
  modified?: string;
}
const {
  title,
  description,
  home = false,
  image,
  type = 'website',
  jsonLd = [],
  noindex = false,
  published,
  modified,
} = Astro.props;

const path = Astro.url.pathname.endsWith('/') || Astro.url.pathname.includes('.') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = absolute(path);
const fullTitle = home ? title : `${title} · ${app.shortName}`;
const ogImage = image ?? absolute('/og/default.png');

const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${app.siteUrl}/#website`,
  url: `${app.siteUrl}/`,
  name: app.name,
  alternateName: app.shortName,
  description: app.oneLiner,
  inLanguage: 'en',
  publisher: { '@id': `${app.siteUrl}/#developer` },
};
const developerLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${app.siteUrl}/#developer`,
  name: app.developer,
  url: `${app.siteUrl}/press/`,
  email: app.supportEmail,
  jobTitle: 'Independent app developer',
};
const appLd = {
  '@context': 'https://schema.org',
  '@type': ['SoftwareApplication', 'MobileApplication'],
  '@id': `${app.siteUrl}/#app`,
  name: app.name,
  alternateName: [app.shortName, 'Companions aquarium widget', 'Companions fish tank widget'],
  description: app.oneLiner,
  url: `${app.siteUrl}/`,
  image: absolute('/icon-512.png'),
  applicationCategory: 'LifestyleApplication',
  applicationSubCategory: 'Home Screen widget',
  operatingSystem: `${app.minimumOS} or later, iPadOS, macOS (iPhone widgets), watchOS`,
  softwareVersion: app.version,
  dateModified: app.versionDate,
  datePublished: app.firstReleased,
  installUrl: app.appStoreUrl,
  downloadUrl: app.appStoreUrl,
  sameAs: [app.appStoreUrlUS],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    description: 'Free download with the starter fish and the Freshwater Pack; more fish come in one-time packs or the All Fish unlock.',
  },
  author: { '@id': `${app.siteUrl}/#developer` },
  publisher: { '@id': `${app.siteUrl}/#developer` },
  inLanguage: ['en', 'ar', 'de', 'es', 'fr', 'it', 'ja', 'ko', 'pt', 'ru', 'zh-Hans', 'zh-Hant'],
  featureList: [
    'Animated aquarium Home Screen widget in small, medium and large',
    '58 fish species in 12 packs, each tank keeps up to five fish',
    'Eight tank styles and 19 props to arrange',
    'Time, date, weather, step goal and Moon phase complications in a tank corner',
    'StandBy, Apple Watch and Mac (iPhone widgets) support',
    'Share tanks with friends as codes or pictures',
    'No account, no advertising, no tracking',
  ],
  screenshot: absolute('/og/default.png'),
};
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#b9d9fb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0f16" />
    <meta name="color-scheme" content="light dark" />

    <meta name="apple-itunes-app" content={`app-id=${app.appStoreId}`} />
    <meta name="application-name" content={app.shortName} />
    <meta name="apple-mobile-web-app-title" content={app.shortName} />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/PlusJakartaSans-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={app.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${app.name}: ${app.tagline}`} />
    <meta property="og:locale" content="en_US" />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(developerLd)} />
    {home && <script type="application/ld+json" set:html={JSON.stringify(appLd)} />}
    {jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...item })} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <TopBar current={path} hero={home} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
