---
/**
 * Every page's shell: metadata for search engines and link previews, the Smart App
 * Banner, structured data, fonts, the top bar and the footer, and visitor statistics once
 * app.json names a Google Analytics property.
 */
import '../styles/global.css';
import '../styles/glass.css';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { app, absolute, species, packs, props as allProps } from '../lib/site';
import sync from '../data/sync.json';
import { useLocale, locales, localeCodes, localePath, splitLocale, defaultLocale, hreflangsOf, type LocaleCode } from '../i18n/index.ts';

interface Props {
  title: string;
  description: string;
  /** Set for the home page, which has its own title and hero top bar. */
  home?: boolean;
  /** Absolute URL of the social preview picture; the default card otherwise. */
  image?: string;
  type?: 'website' | 'article';
  /** Extra JSON-LD objects for this page. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  published?: string;
  modified?: string;
  /** The languages this page is published in, when not all of them (an entry whose
      translation has not been written yet). Search engines are told about these only. */
  locales?: LocaleCode[];
}
const {
  title,
  description,
  home = false,
  image,
  type = 'website',
  jsonLd = [],
  noindex = false,
  published,
  modified,
  locales: available = localeCodes,
} = Astro.props;

const { locale, t, l } = useLocale(Astro.url);

const path = Astro.url.pathname.endsWith('/') || Astro.url.pathname.includes('.') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = absolute(path);
const fullTitle = home ? title : `${title} · ${app.shortName}`;
const ogImage = image ?? absolute(`/og/${locale.code === defaultLocale ? 'default' : locale.code}.png`);

// The same page in each language it exists in. Search engines read these as hreflang
// links (and in the sitemap) to show each reader their own language; the footer's
// language menu uses them too, falling back to a language's home page where this page
// has no translation, and on pages that are not indexed at all.
const shared = splitLocale(path).path;
const inLocales = locales.filter((x) => available.includes(x.code));
const alternates = noindex
  ? []
  : inLocales.flatMap((x) => hreflangsOf(x).map((hreflang) => ({ hreflang, href: absolute(localePath(x.code, shared)) })));
const xDefault = !noindex && available.includes(defaultLocale) ? absolute(localePath(defaultLocale, shared)) : null;
const languages = locales.map((x) => ({
  code: x.code,
  lang: x.lang,
  hreflang: x.hreflang,
  name: x.name,
  href: !noindex && available.includes(x.code) ? localePath(x.code, shared) : localePath(x.code, '/'),
  current: x.code === locale.code,
}));

// Every other kind of structured data on the site describes a page of words, and says
// which language they are in.
const languageless = ['BreadcrumbList', 'ItemList'];

const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${app.siteUrl}/#website`,
  url: `${app.siteUrl}/`,
  name: app.name,
  alternateName: app.shortName,
  description: t.app.oneLiner,
  inLanguage: locales.map((x) => x.hreflang),
  publisher: { '@id': `${app.siteUrl}/#developer` },
};
const developerLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${app.siteUrl}/#developer`,
  name: app.developer,
  url: absolute(l('/press/')),
  email: app.supportEmail,
  jobTitle: t.ld.jobTitle,
};
const appLd = {
  '@context': 'https://schema.org',
  '@type': ['SoftwareApplication', 'MobileApplication'],
  '@id': `${app.siteUrl}/#app`,
  name: t.app.name,
  alternateName: [app.shortName, ...t.ld.alternateNames],
  description: t.app.oneLiner,
  url: canonical,
  image: absolute('/icon-512.png'),
  applicationCategory: 'LifestyleApplication',
  applicationSubCategory: 'Home Screen widget',
  operatingSystem: `${app.minimumOS} or later, iPadOS, macOS (iPhone widgets), watchOS`,
  softwareVersion: app.version,
  dateModified: app.versionDate,
  datePublished: app.firstReleased,
  installUrl: app.appStoreUrl,
  downloadUrl: app.appStoreUrl,
  sameAs: [app.appStoreUrlUS],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    description: t.ld.offer,
  },
  author: { '@id': `${app.siteUrl}/#developer` },
  publisher: { '@id': `${app.siteUrl}/#developer` },
  inLanguage: sync.languages,
  featureList: t.ld.features({ species: species.length, packs: packs.length, props: allProps.filter((p) => p.isDecoration).length }),
  screenshot: ogImage,
};
---

<!doctype html>
<html lang={locale.lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    {home && app.googleSiteVerification && <meta name="google-site-verification" content={app.googleSiteVerification} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#b9d9fb" />
    <meta name="color-scheme" content="only light" />

    <meta name="apple-itunes-app" content={`app-id=${app.appStoreId}`} />
    <meta name="application-name" content={app.shortName} />
    <meta name="apple-mobile-web-app-title" content={app.shortName} />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={app.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.og.imageAlt(t.app.name, t.app.tagline)} />
    <meta property="og:locale" content={locale.og} />
    {!noindex && inLocales.filter((x) => x.code !== locale.code).map((x) => <meta property="og:locale:alternate" content={x.og} />)}
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(developerLd)} />
    {home && <script type="application/ld+json" set:html={JSON.stringify(appLd)} />}
    {jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...(languageless.includes(String(item['@type'])) ? {} : { inLanguage: locale.lang }), ...item })} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.common.skipToContent}</a>
    <TopBar current={shared} hero={home} />
    <main id="main">
      <slot />
    </main>
    <Footer flush={home} languages={languages} />
    <script>
      import '../scripts/site.js';
      import '../scripts/glass.js';
    </script>
    {app.googleAnalyticsId && <Analytics />}
  </body>
</html>
