---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { absolute, app, isoDate } from '../../../lib/site';
import { getNews } from '../../../lib/content';
import { useLocale, localePaths } from '../../../i18n/index.ts';

export function getStaticPaths() {
  return localePaths();
}
const { locale, t, l, date } = useLocale(Astro.url);
const w = t.whatsNew;

const entries = (await getNews(locale.code)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const rendered = await Promise.all(entries.map(async (item) => ({ item, Content: (await render(item.entry)).Content })));
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Companions', item: absolute(l('/')) },
    { '@type': 'ListItem', position: 2, name: t.nav.whatsNew, item: absolute(l('/whats-new/')) },
  ],
};
---

<Base title={w.title} description={w.description(app.version, date(app.versionDate))} jsonLd={[crumbs]}>
  <section class="page-head">
    <div class="container container--narrow">
      <span class="kicker">{w.kicker}</span>
      <h1>{w.h1}</h1>
      <p class="lead">{w.lead(app.version, date(app.versionDate))}</p>
    </div>
  </section>
  <section class="section--tight">
    <div class="container container--narrow">
      {
        rendered.map(({ item, Content }) => (
          <article class="release" id={`v${item.data.version}`}>
            <header>
              <p class="card__kicker">
                <time datetime={isoDate(item.data.date)}>{date(item.data.date)}</time>
              </p>
              <h2>
                <a href={l(`/whats-new/${item.id}/`)}>{w.heading(item.data.version, item.data.title)}</a>
              </h2>
            </header>
            <div class="prose">
              <Content />
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .release + .release {
    margin-top: clamp(40px, 6vw, 72px);
    padding-top: clamp(40px, 6vw, 72px);
    border-top: 1px solid var(--line);
  }
  .release h2 {
    font-size: 1.3rem;
    margin-bottom: 18px;
  }
  .release h2 a {
    color: var(--ink);
  }
</style>
