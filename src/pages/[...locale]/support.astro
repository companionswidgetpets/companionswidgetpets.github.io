---
import Base from '../../layouts/Base.astro';
import { absolute, app } from '../../lib/site';
import { getHelp } from '../../lib/content';
import { useLocale, localePaths } from '../../i18n/index.ts';

export function getStaticPaths() {
  return localePaths();
}
const { locale, t, l } = useLocale(Astro.url);
const s = t.support;

const popular = (await getHelp(locale.code)).filter((e) => e.data.featured).sort((a, b) => a.data.order - b.data.order);
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Companions', item: absolute(l('/')) },
    { '@type': 'ListItem', position: 2, name: t.nav.support, item: absolute(l('/support/')) },
  ],
};
const contact = {
  '@type': 'ContactPage',
  name: s.contactName,
  url: absolute(l('/support/')),
  about: { '@id': `${app.siteUrl}/#app` },
};
const email = `<a href="mailto:${app.supportEmail}">${app.supportEmail}</a>`;
---

<Base title={s.title} description={s.description(app.supportEmail)} jsonLd={[crumbs, contact]}>
  <section class="page-head">
    <div class="container container--narrow">
      <span class="kicker">{s.kicker}</span>
      <h1>{s.h1}</h1>
      <p class="lead" set:html={s.leadHtml(email)} />
    </div>
  </section>

  <section class="section--tight">
    <div class="container container--narrow prose">
      <h2>{s.beforeTitle}</h2>
      <p set:html={s.beforeHtml(l('/help/'))} />
      <ul>
        {popular.map((e) => <li><a href={l(`/help/${e.id}/`)}>{e.data.question}</a></li>)}
      </ul>

      <h2>{s.includeTitle}</h2>
      <ul>
        {s.include.map((line) => <li>{line}</li>)}
      </ul>

      <h2>{s.purchasesTitle}</h2>
      <p set:html={s.purchasesHtml('https://reportaproblem.apple.com')} />

      <h2>{s.privacyTitle}</h2>
      <p set:html={s.privacyHtml(l('/privacy/'))} />

      <h2>{s.wishTitle}</h2>
      <p>{s.wish}</p>
    </div>
  </section>
</Base>
