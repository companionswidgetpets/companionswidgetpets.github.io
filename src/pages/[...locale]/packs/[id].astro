---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Tank from '../../../components/Tank.astro';
import { absolute, packs, speciesById, styleById } from '../../../lib/site';
import { fishMeta } from '../../../lib/pictures';
import { packStyle, premadeProps } from '../../../lib/tanks';
import sync from '../../../data/sync.json';
import { useLocale, localeCodes, localeParam } from '../../../i18n/index.ts';

export function getStaticPaths() {
  return localeCodes.flatMap((code) => packs.map((pack) => ({ params: { locale: localeParam(code), id: pack.id }, props: { pack } })));
}
const { pack } = Astro.props;
const { locale, t, l, name, tagline, list, languageName } = useLocale(Astro.url);
const p = t.pack;

const fish = pack.species.map((id) => speciesById(id));
const styleId = packStyle[pack.id] ?? 'minimal';
const style = styleById(styleId);
const names = list(fish.map((s) => name(s)));
// The other languages the app names these fish in: all it speaks but the page's own.
const langs = sync.languages.filter((lang) => lang !== locale.data);

const others = packs.filter((x) => x.id !== pack.id);
const title = p.title(name(pack), names);
const description = p.description({ tagline: tagline(pack), pack: name(pack), count: fish.length, fish: names, free: pack.comesWithApp });
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Companions', item: absolute(l('/')) },
    { '@type': 'ListItem', position: 2, name: t.footer.packs, item: absolute(l('/packs/')) },
    { '@type': 'ListItem', position: 3, name: name(pack), item: absolute(l(`/packs/${pack.id}/`)) },
  ],
};
---

<Base title={title} description={description} jsonLd={[crumbs]}>
  <section class="page-head">
    <div class="container">
      <nav class="breadcrumbs" aria-label={t.common.breadcrumb}>
        <ol>
          <li><a href={l('/')}>Companions</a></li>
          <li><a href={l('/packs/')}>{t.footer.packs}</a></li>
        </ol>
      </nav>
      <span class="kicker">{pack.comesWithApp ? p.kickerFree : p.kickerPaid}</span>
      <h1>{name(pack)}</h1>
      <p class="lead">{tagline(pack)}</p>
    </div>
  </section>

  <section class="section--tight">
    <div class="container pack-page">
      <div class="pack-page__tank">
        <Tank
          id={`pack-${pack.id}`}
          size="medium"
          style={styleId}
          fish={fish.map((s, i) => ({ species: s.id, seed: `pack-${pack.id}-${i}` }))}
          props={premadeProps('medium', styleId)}
          label={p.tankLabel(name(style), name(pack), names)}
        />
        <p class="meta" style="text-align:center;margin-top:10px">{p.tankCaption(name(pack), name(style))}</p>
      </div>

      <div class="grid grid--3 pack-page__fish">
        {
          fish.map((s) => (
            <article class="card fishcard" id={s.id}>
              <Image src={fishMeta(s.id)} alt={p.fishAlt(name(s))} width={200} height={200} densities={[1, 2]} format="webp" loading="lazy" class="fish-pic" />
              <h2>{name(s)}</h2>
              <p>{p.fishText(name(s), s.swimStyle as 'swimmer' | 'floater' | 'creeper' | 'crawler', s.tankScale)}</p>
            </article>
          ))
        }
      </div>

      <div class="prose pack-page__text">
        <h2>{p.howTitle}</h2>
        <ol class="steps">
          <li set:html={p.step1Html} />
          <li set:html={p.step2Html(name(pack))} />
          <li set:html={pack.comesWithApp ? p.step3FreeHtml : p.step3PaidHtml} />
        </ol>
        <p>{p.after}</p>

        <h2>{p.namesTitle}</h2>
        <p>{p.namesIntro(sync.languages.length)}</p>
        <table>
          <thead>
            <tr>
              <th>{p.languageHeader}</th>
              {fish.map((s) => <th>{name(s)}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              langs.map((lang) => (
                <tr>
                  <td>{languageName(lang)}</td>
                  {fish.map((s) => <td lang={lang}>{s.names[lang as keyof typeof s.names]}</td>)}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <aside class="pack-page__others">
        <h2>{p.others}</h2>
        <div class="chip-row">
          {others.map((x) => <a class="chip" href={l(`/packs/${x.id}/`)}>{name(x)}</a>)}
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .pack-page__tank {
    max-width: 760px;
    margin: 0 auto clamp(32px, 5vw, 56px);
  }
  .fishcard {
    text-align: center;
  }
  .fishcard img {
    width: 140px;
    height: 140px;
    margin: 0 auto 14px;
  }
  .fishcard h2 {
    font-size: 1.05rem;
    margin-bottom: 8px;
  }
  .pack-page__text {
    margin: clamp(40px, 6vw, 64px) auto 0;
  }
  .pack-page__text table {
    display: block;
    overflow-x: auto;
  }
  .pack-page__others {
    margin-top: clamp(40px, 6vw, 64px);
  }
  .pack-page__others h2 {
    font-size: 1.15rem;
    margin-bottom: 14px;
  }
</style>
