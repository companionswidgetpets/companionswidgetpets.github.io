---
import Base from '../../layouts/Base.astro';
import Tank from '../../components/Tank.astro';
import { absolute, styles, rgb } from '../../lib/site';
import { styleFish, premadeProps } from '../../lib/tanks';
import sync from '../../data/sync.json';

const blurbs: Record<string, string> = {
  minimal: 'The blue tank the app launched with: lighter azure at the top, settling into a bright sky blue through the middle, over a white mist. Bright, clean, and the one most fish look best in.',
  deepOcean: 'Sapphire where the light gets in at the top, falling through navy to an indigo that is all but black at the bottom. Jellyfish glow in it; reef fish pop.',
  pond: 'Sunlit green at the surface deepening to leaf green, turning a touch olive as it meets a bed of warm sand. Made for koi, trout and the pond creatures.',
  reed: 'A cooler, teal-leaning green, the nearest cousin to Minimal in temperature, over a muted tan bed. Switching between the two reads as a change of light rather than a different tank.',
  blossom: 'Pale cherry-blossom pink at the surface settling into a soft rose, over the same white mist as Minimal. Kept on the cool side of pink so orange and red fish keep their edge.',
  dark: 'As black as the Home Screen allows, for all-black setups: neutral charcoal at the surface falling to true black under the bed, with the glass highlights turned down so it sits quietly among dark icons.',
  pumpkin: 'Soft pumpkin orange at the surface settling into a deeper orange, over a white mist. Kept short of yellow so the goldfish and the gold koi still stand out.',
  lavender: 'Minimal and Blossom with the hue turned to the lavender flower: as vivid as a lavender this light can be, over the same white mist. Discus and dartfish suit it.',
};
const languageNames: Record<string, string> = {
  ar: 'Arabic', de: 'German', es: 'Spanish', fr: 'French', it: 'Italian', ja: 'Japanese',
  ko: 'Korean', pt: 'Portuguese', ru: 'Russian', 'zh-Hans': 'Simplified Chinese', 'zh-Hant': 'Traditional Chinese',
};
const langs = sync.languages.filter((l) => l !== 'en');

const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Companions', item: absolute('/') },
    { '@type': 'ListItem', position: 2, name: 'Tank styles', item: absolute('/styles/') },
  ],
};
---

<Base
  title="The eight tank styles"
  description={`Every water the Companions aquarium widget comes in: ${styles.map((s) => s.names.en).join(', ')}. What each looks like, which fish suit it, and how to change the style of a tank.`}
  jsonLd={[crumbs]}
>
  <section class="page-head">
    <div class="container">
      <span class="kicker">{styles.length} styles</span>
      <h1>The same glass, different water.</h1>
      <p class="lead">
        A style colours the water and the bed; the glass, its rim and its highlights stay the same, so the small, medium
        and large tanks read as the same tank, just bigger. Change a tank's style on the Edit Tank page and every
        widget showing that tank follows.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      {
        styles.map((s, i) => (
          <article class={`style ${i % 2 ? 'style--flip' : ''}`} id={s.id}>
            <div class="style__tank">
              <Tank
                id={`styles-${s.id}`}
                size="medium"
                style={s.id}
                fish={[...styleFish[s.id], { species: i % 2 ? 'sardine' : 'tang', seed: `styles-${s.id}-3` }]}
                props={premadeProps('medium', s.id)}
                label={`The ${s.names.en} tank style, medium widget size`}
              />
            </div>
            <div class="style__text">
              <p class="card__kicker" style={`color:${rgb(s.palette.water[2].rgb)}`}>Style {i + 1} of {styles.length}</p>
              <h2>{s.names.en}</h2>
              <p>{blurbs[s.id]}</p>
              <p class="style__langs">
                {langs.map((l) => (
                  <span>
                    <span class="meta">{languageNames[l]}</span> <span lang={l}>{s.names[l as keyof typeof s.names]}</span>
                  </span>
                ))}
              </p>
            </div>
          </article>
        ))
      }

      <div class="prose" style="margin-top:72px">
        <h2>How to change a tank's style</h2>
        <ol class="steps">
          <li>Open Companions and tap the <strong>⋯</strong> button at the top of the page, then <strong>Edit this tank</strong>.</li>
          <li>Open the style menu at the top of the Edit Tank page and pick a water. The tank changes under your finger.</li>
          <li>Tap <strong>Close</strong>. The tank saves itself, and the widget on your Home Screen updates to match.</li>
        </ol>
        <p>
          Styles belong to tanks, not to the app: on the My Tanks page you can keep a Blossom small tank and a Dark
          large tank side by side, and switch which one your widget shows.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .style {
    display: grid;
    gap: clamp(20px, 4vw, 48px);
    align-items: center;
    grid-template-columns: 1fr;
    padding-block: clamp(24px, 4vw, 40px);
  }
  .style + .style {
    border-top: 1px solid var(--line);
  }
  @media (min-width: 820px) {
    .style {
      grid-template-columns: 1.15fr 1fr;
    }
    .style--flip .style__tank {
      order: 2;
    }
  }
  .style__text h2 {
    font-size: 1.8rem;
    margin-bottom: 12px;
  }
  .style__text p {
    color: var(--ink-2);
  }
  .style__langs {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 0.9rem;
  }
</style>
