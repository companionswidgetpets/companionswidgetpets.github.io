---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Tank from '../../components/Tank.astro';
import { absolute, packs, speciesById, styleById } from '../../lib/site';
import { fishMeta } from '../../lib/pictures';
import { packStyle, premadeProps } from '../../lib/tanks';
import sync from '../../data/sync.json';

export function getStaticPaths() {
  return packs.map((pack) => ({ params: { id: pack.id }, props: { pack } }));
}
const { pack } = Astro.props;
const fish = pack.species.map((id) => speciesById(id));
const styleId = packStyle[pack.id] ?? 'minimal';
const style = styleById(styleId);
const names = fish.map((s) => s.names.en);
const languageNames: Record<string, string> = {
  en: 'English', ar: 'Arabic', de: 'German', es: 'Spanish', fr: 'French', it: 'Italian', ja: 'Japanese',
  ko: 'Korean', pt: 'Portuguese', ru: 'Russian', 'zh-Hans': 'Simplified Chinese', 'zh-Hant': 'Traditional Chinese',
};
const langs = sync.languages.filter((l) => l !== 'en');
const swimNote: Record<string, string> = {
  swimmer: 'swims mid-water, gliding briskly with a little rise and fall',
  floater: 'floats rather than swims: it hangs anywhere a fish might, drifting slowly',
  creeper: 'keeps to the bed and inches along it, so slowly it is hardly seen to move, leaning a little with its way',
  crawler: 'walks the bed at a scuttle, a touch up and down as its legs go',
};
const sizeNote = (scale: number) =>
  scale > 1 ? `drawn ${Math.round((scale - 1) * 100)}% bigger than a standard fish` : scale < 1 ? `drawn a touch smaller than a standard fish` : null;

const others = packs.filter((p) => p.id !== pack.id);
const title = `${pack.names.en}: ${names.join(', ')}`;
const description = `${pack.taglines.en} The ${pack.names.en} in the Companions aquarium widget holds ${fish.length} fish: ${names.join(', ')}. ${pack.comesWithApp ? 'It comes with the app for free.' : 'A one-time in-app purchase, or part of All Fish.'}`;
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Companions', item: absolute('/') },
    { '@type': 'ListItem', position: 2, name: 'Fish and packs', item: absolute('/packs/') },
    { '@type': 'ListItem', position: 3, name: pack.names.en, item: absolute(`/packs/${pack.id}/`) },
  ],
};
---

<Base title={title} description={description} jsonLd={[crumbs]}>
  <section class="page-head">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Companions</a></li>
          <li><a href="/packs/">Fish and packs</a></li>
        </ol>
      </nav>
      <span class="kicker">{pack.comesWithApp ? 'Comes with the app' : 'Fish pack'}</span>
      <h1>{pack.names.en}</h1>
      <p class="lead">{pack.taglines.en}</p>
    </div>
  </section>

  <section class="section--tight">
    <div class="container pack-page">
      <div class="pack-page__tank">
        <Tank
          id={`pack-${pack.id}`}
          size="medium"
          style={styleId}
          fish={fish.map((s, i) => ({ species: s.id, seed: `pack-${pack.id}-${i}` }))}
          props={premadeProps('medium', styleId)}
          label={`A ${style.names.en} tank with the ${pack.names.en}: ${names.join(', ')}`}
        />
        <p class="meta" style="text-align:center;margin-top:10px">The {pack.names.en} in a {style.names.en} tank, medium widget size.</p>
      </div>

      <div class="grid grid--3 pack-page__fish">
        {
          fish.map((s) => (
            <article class="card fishcard" id={s.id}>
              <Image src={fishMeta(s.id)} alt={`${s.names.en} as drawn in Companions`} width={200} height={200} densities={[1, 2]} format="webp" loading="lazy" class="fish-pic" />
              <h2>{s.names.en}</h2>
              <p>
                The {s.names.en.toLowerCase()} {swimNote[s.swimStyle]}
                {sizeNote(s.tankScale) ? `, and is ${sizeNote(s.tankScale)}` : ''}.
              </p>
            </article>
          ))
        }
      </div>

      <div class="prose pack-page__text">
        <h2>How to add these fish</h2>
        <ol class="steps">
          <li>Open Companions and tap the <strong>+</strong> at the end of the tray under the tank.</li>
          <li>Find the <strong>{pack.names.en}</strong> in the list and tap a fish.</li>
          {
            pack.comesWithApp ? (
              <li>It drops into the water with a splash. Give it a name, or keep the one it came with.</li>
            ) : (
              <li>
                If the pack is locked, tap <strong>Unlock</strong> and buy the pack once, or All Fish for every pack.
                Then the fish drops into the water with a splash. Give it a name, or keep the one it came with.
              </li>
            )
          }
        </ol>
        <p>
          A tank holds five fish, and each widget size keeps its own set, so the small, medium and large tanks can
          be stocked differently.
        </p>

        <h2>Names in other languages</h2>
        <p>Companions is translated into {langs.length + 1} languages. These are the names the app uses for these fish:</p>
        <table>
          <thead>
            <tr>
              <th>Language</th>
              {fish.map((s) => <th>{s.names.en}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              langs.map((lang) => (
                <tr>
                  <td>{languageNames[lang]}</td>
                  {fish.map((s) => <td lang={lang}>{s.names[lang as keyof typeof s.names]}</td>)}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <aside class="pack-page__others">
        <h2>Other packs</h2>
        <div class="chip-row">
          {others.map((p) => <a class="chip" href={`/packs/${p.id}/`}>{p.names.en}</a>)}
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .pack-page__tank {
    max-width: 760px;
    margin: 0 auto clamp(32px, 5vw, 56px);
  }
  .fishcard {
    text-align: center;
  }
  .fishcard img {
    width: 140px;
    height: 140px;
    margin: 0 auto 14px;
  }
  .fishcard h2 {
    font-size: 1.3rem;
    margin-bottom: 8px;
  }
  .pack-page__text {
    margin: clamp(40px, 6vw, 64px) auto 0;
  }
  .pack-page__text table {
    display: block;
    overflow-x: auto;
  }
  .pack-page__others {
    margin-top: clamp(40px, 6vw, 64px);
  }
  .pack-page__others h2 {
    font-size: 1.3rem;
    margin-bottom: 14px;
  }
</style>
