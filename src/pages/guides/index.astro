---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { absolute, formatDate } from '../../lib/site';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Companions', item: absolute('/') },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: absolute('/guides/') },
  ],
};
---

<Base
  title="Guides"
  description="Step-by-step guides to the Companions aquarium widget: adding it to your iPhone Home Screen, StandBy, Apple Watch and Mac, designing tanks, complications, feeding and sharing."
  jsonLd={[crumbs]}
>
  <section class="page-head">
    <div class="container">
      <span class="kicker">Guides</span>
      <h1>Get the most out of your tank.</h1>
      <p class="lead">Longer reads: how the widget works, how to set it up everywhere, and the little things worth knowing.</p>
    </div>
  </section>
  <section class="section--tight">
    <div class="container">
      <div class="grid grid--3">
        {
          guides.map((g) => (
            <a class="card card--link" href={`/guides/${g.id}/`}>
              <p class="card__kicker">{g.data.kicker}</p>
              <h3>{g.data.title}</h3>
              <p>{g.data.description}</p>
              <p class="meta" style="margin-top:14px">{formatDate(g.data.updated ?? g.data.published)}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
