---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { absolute, app, formatDate, isoDate } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('guides');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

const others = (await getCollection('guides')).filter((g) => g.id !== entry.id).sort((a, b) => a.data.order - b.data.order).slice(0, 3);

const published = isoDate(entry.data.published);
const modified = isoDate(entry.data.updated ?? entry.data.published);
const articleLd = {
  '@type': 'TechArticle',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: published,
  dateModified: modified,
  author: { '@id': `${app.siteUrl}/#developer` },
  publisher: { '@id': `${app.siteUrl}/#developer` },
  mainEntityOfPage: absolute(`/guides/${entry.id}/`),
  image: absolute('/og/default.png'),
  about: { '@id': `${app.siteUrl}/#app` },
  inLanguage: 'en',
};
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Companions', item: absolute('/') },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: absolute('/guides/') },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: absolute(`/guides/${entry.id}/`) },
  ],
};
---

<Base title={entry.data.title} description={entry.data.description} type="article" jsonLd={[articleLd, crumbs]} published={published} modified={modified}>
  <article>
    <header class="page-head">
      <div class="container container--narrow">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Companions</a></li>
            <li><a href="/guides/">Guides</a></li>
          </ol>
        </nav>
        <span class="kicker">{entry.data.kicker}</span>
        <h1>{entry.data.title}</h1>
        <p class="lead">{entry.data.description}</p>
        <p class="meta">
          By {app.developer} · {formatDate(entry.data.published)}
          {entry.data.updated && <span> · Updated {formatDate(entry.data.updated)}</span>} · Companions {app.version}
        </p>
      </div>
    </header>
    <div class="container container--narrow">
      {
        toc.length > 2 && (
          <nav class="toc" aria-label="On this page">
            <p class="card__kicker">On this page</p>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="prose">
        <Content />
      </div>
      <aside class="more">
        <h2>More guides</h2>
        <div class="grid grid--3">
          {
            others.map((g) => (
              <a class="card card--link" href={`/guides/${g.id}/`}>
                <p class="card__kicker">{g.data.kicker}</p>
                <h3>{g.data.title}</h3>
              </a>
            ))
          }
        </div>
      </aside>
    </div>
  </article>
</Base>

<style>
  .toc {
    margin-bottom: clamp(28px, 4vw, 40px);
    padding: 18px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
  }
  .toc ol {
    margin: 0;
    padding-left: 1.2em;
    columns: 2;
    column-gap: 24px;
    font-size: 0.95rem;
  }
  .toc li + li {
    margin-top: 6px;
  }
  @media (max-width: 600px) {
    .toc ol {
      columns: 1;
    }
  }
  .more {
    margin-top: clamp(48px, 7vw, 80px);
  }
  .more h2 {
    font-size: 1.4rem;
    margin-bottom: 18px;
  }
</style>
