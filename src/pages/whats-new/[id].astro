---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { absolute, app, formatDate, isoDate } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('news');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const date = isoDate(entry.data.date);
const ld = {
  '@type': 'TechArticle',
  headline: `Companions ${entry.data.version}: ${entry.data.title}`,
  description: entry.data.summary,
  datePublished: date,
  dateModified: date,
  author: { '@id': `${app.siteUrl}/#developer` },
  about: { '@id': `${app.siteUrl}/#app` },
  mainEntityOfPage: absolute(`/whats-new/${entry.id}/`),
};
---

<Base title={`Companions ${entry.data.version}: ${entry.data.title}`} description={entry.data.summary} type="article" jsonLd={[ld]} published={date} modified={date}>
  <article>
    <header class="page-head">
      <div class="container container--narrow">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Companions</a></li>
            <li><a href="/whats-new/">What's new</a></li>
          </ol>
        </nav>
        <span class="kicker">Version {entry.data.version}</span>
        <h1>{entry.data.title}</h1>
        <p class="lead">{entry.data.summary}</p>
        <p class="meta"><time datetime={date}>{formatDate(entry.data.date)}</time></p>
      </div>
    </header>
    <div class="container container--narrow">
      <div class="prose"><Content /></div>
      <p style="margin-top:40px"><a href="/whats-new/">All versions</a></p>
    </div>
  </article>
</Base>
