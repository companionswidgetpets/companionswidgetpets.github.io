---
/**
 * The home page's opening: sky fading to white, the phone standing in the middle with the
 * fish swimming in its widget, and, as the page scrolls, the phone sliding right and
 * shrinking while the headline arrives from the left (scripts/hero.js drives --p and --tp).
 */
import Phone from './Phone.astro';
import Tank from './Tank.astro';
import Badge from './Badge.astro';
import { heroTank } from '../lib/tanks';
import { useLocale } from '../i18n/index.ts';

const { t } = useLocale(Astro.url);
---

<section class="hero" data-hero aria-label={t.hero.label}>
  <div class="hero__stage">
    <div class="hero__sky" aria-hidden="true"></div>

    <div class="hero__copy">
      <h1 class="hero__title" set:html={t.hero.titleHtml} />
      <p class="hero__sub">{t.app.subtitle}</p>
      <div class="hero__cta">
        <Badge loading="eager" />
      </div>
    </div>

    <div class="hero__phone">
      <Phone loading="eager">
        <Tank
          id={heroTank.id}
          size={heroTank.size}
          style={heroTank.style}
          look="widget"
          fish={heroTank.fish}
          props={heroTank.props}
          fishSize={0}
          label={t.hero.tankLabel}
        />
      </Phone>
    </div>

    <div class="hero__hint" aria-hidden="true">
      <span>{t.hero.scroll}</span>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 5l5 5 5-5" /></svg>
    </div>
  </div>
</section>

<style is:global>
  .hero {
    /* Defaults show the finished state, for no JavaScript and for Reduce Motion. */
    --p: 1;
    --tp: 1;
    --s1: 0.74;
    --dx: 24vw;
    --dy: -8vh;
    --phone-w: min(29vw, 620px);
    --phone-top: 27vh;
    position: relative;
    height: 230vh;
    margin-top: 0;
  }
  .hero--static {
    height: 100vh;
  }
  @media (scripting: none) {
    .hero {
      height: 100vh;
    }
  }
  .hero__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }
  .hero__sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--sky-1) 0%, var(--sky-2) 48%, var(--bg) 74%);
  }
  .hero__phone {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: var(--phone-top);
    width: var(--phone-w);
    margin-left: calc(var(--phone-w) / -2);
    transform: translate(calc(var(--p) * var(--dx)), calc(var(--p) * var(--dy))) scale(calc(1 + var(--p) * (var(--s1) - 1)));
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .hero__phone .phone {
    width: 100%;
  }
  .hero__copy {
    position: absolute;
    z-index: 3;
    left: 14.5vw;
    top: 50%;
    transform: translateY(-50%) translateX(calc((1 - var(--tp)) * -48px));
    opacity: var(--tp);
  }
  /* Two fixed lines, as in the mockup. The size is whatever lets "on your Home Screen."
     (15.5 times the font size wide at this width and tracking) end 3vw short of the
     phone, whose final left edge is 73.5vw minus half its 39.1vh width. */
  .hero__title {
    font-size: clamp(28px, calc(3.61vw - 1.26vh), 64px);
    white-space: nowrap;
    color: var(--ink);
  }
  .hero__sub {
    margin-top: clamp(16px, 1.8vw, 24px);
    font-size: clamp(1.1rem, 1.7vw, 1.6rem);
    line-height: 1.35;
    color: var(--ink-3);
    max-width: 30ch;
    text-wrap: pretty;
  }
  .hero__cta {
    margin-top: clamp(24px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }
  .hero__hint {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 22px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-3);
    opacity: calc(1 - var(--p) * 2);
    animation: hero-hint 2.4s ease-in-out infinite;
  }
  .hero--settled .hero__hint,
  .hero--static .hero__hint {
    display: none;
  }
  @media (scripting: none) {
    .hero__hint {
      display: none;
    }
  }
  @keyframes hero-hint {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 5px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__hint {
      animation: none;
    }
  }

  @media (max-width: 767px), (max-width: 999px) and (orientation: portrait) {
    .hero {
      --phone-w: min(78vw, 360px);
      --phone-top: 19vh;
      --dx: 0px;
      --dy: 35vh;
      --s1: 0.6;
    }
    .hero__copy {
      left: var(--gutter);
      right: var(--gutter);
      top: calc(var(--topbar-h) + 44px);
      max-width: none;
      transform: translateY(calc((1 - var(--tp)) * 18px));
    }
    .hero__title {
      font-size: min(8vw, 2.3rem);
      white-space: normal;
    }
    .hero__sub {
      font-size: 1rem;
      max-width: 36ch;
    }
    .hero__cta {
      margin-top: 18px;
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px 16px;
    }
    .hero__cta .badge-link img {
      height: 44px;
    }
  }
  @media (min-width: 768px) and (max-width: 1099px) and (orientation: landscape), (min-width: 1000px) and (max-width: 1099px) {
    .hero {
      --phone-w: min(40vw, 420px);
    }
    .hero__copy {
      left: var(--gutter);
    }
    .hero__title {
      font-size: clamp(22px, calc((72vw - 19.6vh - var(--gutter) - 24px) / 15.5), 44px);
    }
  }
</style>

<script>
  import '../scripts/hero.js';
</script>
