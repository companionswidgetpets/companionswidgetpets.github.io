---
/**
 * The frosted-glass pill at the top of every page: the icon and wordmark, the section
 * links and the black Get the app button. Scrolling fades the wordmark and moves
 * the desktop links into the middle of the bar.
 */
import { Image } from 'astro:assets';
import icon from '../assets/icon/app-icon.png';
import getAppIcon from '../assets/icon/get_app.svg';
import { app } from '../lib/site';
import { useLocale } from '../i18n/index.ts';

interface Props {
  /** The page's path without its language folder, to mark the current section. */
  current?: string;
  /** Whether the bar narrows with the hero's scroll animation (home page only). */
  hero?: boolean;
}
const { current = '/', hero = false } = Astro.props;
const { t, l } = useLocale(Astro.url);
const nav = [
  { path: '/help/', label: t.nav.help },
  { path: '/guides/', label: t.nav.guides },
  { path: '/packs/', label: t.nav.fish },
  { path: '/styles/', label: t.nav.styles },
  { path: '/whats-new/', label: t.nav.whatsNew },
];
const isCurrent = (path: string) => (path === '/' ? current === '/' : current.startsWith(path));
---

<header class={`topbar ${hero ? 'topbar--hero' : ''}`} data-topbar>
  <div class="topbar__pill">
    <a class="topbar__brand" href={l('/')} aria-label={t.nav.homeLabel}>
      <Image src={icon} alt="" width={88} height={88} densities={[1, 2]} format="webp" class="topbar__icon" loading="eager" />
      <span class="topbar__wordmark">{app.shortName}</span>
    </a>
    <nav class="topbar__nav" aria-label={t.nav.site}>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={l(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="topbar__actions">
      <a class="topbar__cta" href={app.appStoreUrl} rel="noopener">
        <span class="topbar__cta-long">{t.nav.download}</span>
        <span class="topbar__cta-short">{t.nav.get}</span>
        <img src={getAppIcon.src} width="12" height="18" alt="" aria-hidden="true" />
      </a>
      <button class="topbar__menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
        <span class="visually-hidden">{t.nav.menu}</span>
        <span class="topbar__burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
  <nav class="topbar__sheet" id="site-menu" aria-label={t.nav.site} data-menu hidden>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={l(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li><a href={l('/support/')}>{t.nav.support}</a></li>
      <li><a href={l('/press/')}>{t.nav.press}</a></li>
    </ul>
  </nav>
</header>

<style is:global>
  .topbar {
    --tp: 0;
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16px var(--gutter) 0;
    pointer-events: none;
  }
  @media (min-width: 768px) {
    .topbar {
      padding-top: 22px;
    }
  }
  .topbar__pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    max-width: calc(1400px - var(--tp) * 140px);
    min-height: var(--topbar-h);
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(22px) saturate(1.7);
    backdrop-filter: blur(22px) saturate(1.7);
    border: 1px solid var(--glass-line);
    box-shadow: var(--glass-shadow);
    transition: box-shadow 0.25s ease, background-color 0.25s ease;
  }
  .topbar--scrolled .topbar__pill {
    background: var(--glass-strong);
  }
  .topbar__brand {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--ink);
    text-decoration: none;
    min-width: 0;
  }
  .topbar__brand:hover {
    text-decoration: none;
  }
  .topbar__icon {
    width: 44px;
    height: 44px;
    border-radius: 11px;
    flex: none;
    box-shadow: 0 1px 3px rgba(11, 18, 32, 0.15);
  }
  .topbar__wordmark {
    font-family: var(--font-display);
    font-weight: 750;
    font-stretch: 150%;
    /* 33px on a 1920-wide screen, as in the mockup */
    font-size: clamp(1.25rem, 1.75vw, 2.1rem);
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: opacity 0.25s ease, transform 0.35s ease;
  }
  .topbar--scrolled .topbar__wordmark {
    opacity: 0;
    transform: translateX(-8px);
    pointer-events: none;
  }
  .topbar__nav {
    margin-left: auto;
    display: none;
  }
  .topbar__nav ul {
    list-style: none;
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
  }
  .topbar__nav a {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 999px;
    color: var(--ink-2);
    font-weight: 600;
    font-size: 0.975rem;
    text-decoration: none;
  }
  .topbar__nav a:hover,
  .topbar__nav a[aria-current="page"] {
    color: var(--ink);
    background: rgba(127, 127, 127, 0.12);
  }
  .topbar__actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .topbar__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    gap: 6px;
    min-height: 32px;
    padding: 5px 14px;
    border: 0;
    border-radius: 999px;
    background: #000;
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 22px;
    white-space: nowrap;
    text-decoration: none;
  }
  .topbar__cta:hover {
    text-decoration: none;
  }
  .topbar__cta img {
    width: 12px;
    height: 18px;
    flex: none;
  }
  .topbar__cta-short {
    display: none;
  }
  .topbar__menu-toggle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: grid;
    place-items: center;
    color: var(--ink);
  }
  .topbar__burger {
    width: 20px;
    display: grid;
    gap: 6px;
  }
  .topbar__burger i {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.2s ease;
  }
  .topbar--open .topbar__burger i:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .topbar--open .topbar__burger i:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
  .topbar__sheet {
    pointer-events: auto;
    width: 100%;
    max-width: 1400px;
    margin-top: 10px;
    padding: 10px;
    border-radius: 28px;
    background: var(--glass-strong);
    -webkit-backdrop-filter: blur(22px) saturate(1.7);
    backdrop-filter: blur(22px) saturate(1.7);
    border: 1px solid var(--glass-line);
    box-shadow: var(--glass-shadow);
  }
  .topbar__sheet[hidden] {
    display: none;
  }
  .topbar__sheet ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .topbar__sheet a {
    display: block;
    padding: 14px 16px;
    border-radius: 18px;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 118%;
    font-size: 1.05rem;
    text-decoration: none;
  }
  .topbar__sheet a:hover,
  .topbar__sheet a[aria-current="page"] {
    background: rgba(127, 127, 127, 0.12);
  }
  @media (max-width: 539px) {
    .topbar__wordmark {
      font-size: 0.95rem;
    }
    .topbar__brand {
      gap: 10px;
    }
    .topbar__cta {
      padding-inline: 12px;
    }
    .topbar__cta-long {
      display: none;
    }
    .topbar__cta-short {
      display: inline;
    }
  }
  /* On the narrowest phones the icon alone is the home link. */
  @media (max-width: 379px) {
    .topbar__wordmark {
      display: none;
    }
  }
  @media (min-width: 1000px) {
    .topbar__brand {
      flex: 1 1 0;
      min-width: 44px;
    }
    .topbar__wordmark {
      position: absolute;
      left: 58px;
    }
    .topbar__nav {
      display: block;
      flex: none;
      margin-left: 0;
    }
    .topbar__actions {
      flex: 0 1 0;
      min-width: max-content;
      margin-left: 0;
      justify-content: flex-end;
      transition: flex-grow 0.35s ease;
    }
    /* Equal side columns put the links at the bar's actual centre. */
    .topbar--scrolled .topbar__actions {
      flex-grow: 1;
    }
    .topbar__menu-toggle,
    .topbar__sheet {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .topbar__wordmark,
    .topbar__actions {
      transition: none;
    }
  }
</style>
