---
/**
 * The three widget sizes as live tanks, with a style picker that repaints all three.
 */
import Tank from './Tank.astro';
import { styles, styleById, paletteVars, pageTint, rgb } from '../lib/site';
import { demoFish, premadeProps } from '../lib/tanks';
import { useLocale } from '../i18n/index.ts';

const { t, name } = useLocale(Astro.url);
const initial = styleById('lavender');
---

<section class="section demo" id="sizes" data-style-scope style={`--demo-tint:${pageTint(initial)}`}>
  <div class="container">
    <div class="section__head section__head--center">
      <span class="kicker">{t.sizes.kicker}</span>
      <h2>{t.sizes.title}</h2>
      <p class="lead">{t.sizes.lead}</p>
    </div>

    <div class="chip-row demo__picker" data-style-picker role="group" aria-label={t.sizes.pickerLabel}>
      {
        styles.map((s) => (
          <button
            class="chip"
            type="button"
            aria-pressed={s.id === initial.id ? 'true' : 'false'}
            data-pick-style={s.id}
            data-vars={paletteVars(s)}
            data-name={name(s)}
            data-tint={pageTint(s)}
          >
            <span
              class="chip__swatch"
              style={`background: linear-gradient(${rgb(s.palette.water[0].rgb)}, ${rgb(s.palette.water[2].rgb)})`}
            />
            {name(s)}
          </button>
        ))
      }
    </div>

    <div class="demo__tanks">
      <div class="demo__large">
        <Tank id="demo-large" size="large" style={initial.id} fish={demoFish.large} props={premadeProps('large', initial.id)} />
        <p class="demo__label">{t.sizes.large}</p>
      </div>
      <div class="demo__stack">
        <div>
          <Tank id="demo-medium" size="medium" style={initial.id} fish={demoFish.medium} props={premadeProps('medium', initial.id)} />
          <p class="demo__label">{t.sizes.medium}</p>
        </div>
        <div class="demo__small">
          <Tank id="demo-small" size="small" style={initial.id} fish={demoFish.small} props={premadeProps('small', initial.id)} />
          <p class="demo__label">{t.sizes.small}</p>
        </div>
      </div>
    </div>

    <p class="demo__caption" set:html={t.sizes.captionHtml(`<strong data-style-name>${name(initial)}</strong>`)} />
  </div>
</section>

<style>
  /* A band of the chosen style's colour that fades into the page's water at both ends.
     Registering --demo-tint as a colour is what lets the band cross-fade when the style
     changes; a gradient cannot be transitioned directly. */
  @property --demo-tint {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }
  .demo {
    --band: color-mix(in oklab, var(--demo-tint) 38%, var(--bg));
    background: linear-gradient(to bottom, transparent, var(--band) 140px, var(--band) calc(100% - 140px), transparent);
    transition: --demo-tint 0.5s ease;
  }
  .demo__picker {
    justify-content: center;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .demo__tanks {
    display: grid;
    gap: clamp(16px, 2.4vw, 28px);
    grid-template-columns: 1fr;
    max-width: 1040px;
    margin-inline: auto;
    align-items: start;
  }
  @media (min-width: 720px) {
    .demo__tanks {
      grid-template-columns: 1fr 1fr;
    }
  }
  .demo__stack {
    display: grid;
    gap: clamp(16px, 2.4vw, 28px);
  }
  .demo__small {
    width: calc(170 / 364 * 100%);
  }
  .demo__label {
    margin-top: 10px;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-3);
  }
  .demo__caption {
    margin: clamp(24px, 3vw, 36px) auto 0;
    max-width: 56ch;
    text-align: center;
    color: var(--ink-3);
  }
  .demo__caption strong {
    color: var(--ink);
  }
</style>
