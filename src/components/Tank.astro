---
/**
 * A live tank: glass in one of the app's styles, props standing on the bed and fish
 * swimming the way they do in the app (see scripts/tank.js).
 *
 * `look="widget"` draws the glass from the real Home Screen capture, which already has
 * iOS's own highlight and rim over it; `look="app"` (default) paints the app's glass in
 * CSS from the style's palette, so it can be restyled live.
 */
import { getImage } from 'astro:assets';
import { fishUrl, propUrl } from '../lib/pictures';
import { paletteVars, speciesById, styleById, props as allProps } from '../lib/site';
import widgetSmall from '../assets/widget/small-minimal.png';
import widgetMedium from '../assets/widget/medium-minimal.png';
import widgetLarge from '../assets/widget/large-minimal.png';
import bubblePng from '../assets/props/bubble.png';

interface FishEntry {
  species: string;
  seed?: string;
  name?: string;
}
interface PlacedProp {
  prop: string;
  x: number;
  y: number;
  side: number;
  flipped?: boolean;
}
interface Props {
  id: string;
  size?: 'small' | 'medium' | 'large' | 'watch';
  style?: string;
  fish?: FishEntry[];
  props?: PlacedProp[];
  look?: 'app' | 'widget';
  /** Swim speed notch, -2…2; the app starts at -1. */
  speed?: number;
  /** Fish size notch, -2…2; the app starts at -1. */
  fishSize?: number;
  complication?: { kind: 'time' | 'date'; corner?: 'topLeft' | 'topRight' | 'bottomLeft' | 'bottomRight' };
  bubbles?: boolean;
  class?: string;
  /** Accessible description of the whole tank. */
  label?: string;
}

const {
  id,
  size = 'small',
  style: styleId = 'minimal',
  fish = [],
  props: placed = [],
  look = 'app',
  speed = -1,
  fishSize = -1,
  complication,
  bubbles = true,
  class: className = '',
  label,
} = Astro.props;

const style = styleById(styleId);
const design = {
  small: { w: 190, h: 190 },
  medium: { w: (190 * 364) / 170, h: 190 },
  large: { w: (190 * 364) / 170, h: ((190 * 364) / 170) * (382 / 364) },
  watch: { w: 190, h: (190 * 248) / 208 },
}[size];
const corner = size === 'watch' ? (52 * 190) / 208 : 28;

const fishConfig = await Promise.all(
  fish.map(async (f) => {
    const s = speciesById(f.species);
    return {
      seed: f.seed,
      name: f.name,
      species: {
        id: s.id,
        name: s.names.en,
        image: await fishUrl(s.id),
        tankScale: s.tankScale,
        swimStyle: s.swimStyle,
        footing: s.footing,
      },
    };
  })
);
const propConfig = await Promise.all(
  placed.map(async (p) => {
    const prop = allProps.find((x) => x.id === p.prop);
    if (!prop) throw new Error(`Unknown prop "${p.prop}"`);
    return {
      x: p.x,
      y: p.y,
      side: p.side,
      flipped: Boolean(p.flipped),
      prop: { id: prop.id, image: await propUrl(prop.raw), size: prop.size, footprint: prop.footprint },
    };
  })
);
const bubble = await getImage({ src: bubblePng, width: 64, format: 'webp' });

const config = {
  id,
  size,
  speed,
  fishSize,
  fish: fishConfig,
  props: propConfig,
  bubble: bubbles ? bubble.src : null,
};

const widgetSource = { small: widgetSmall, medium: widgetMedium, large: widgetLarge, watch: widgetSmall }[size];
const widget =
  look === 'widget' ? await getImage({ src: widgetSource, width: widgetSource.width, format: 'webp', quality: 92 }) : null;

const inline = `--dw:${design.w.toFixed(3)};--dh:${design.h.toFixed(3)};--r:${corner.toFixed(2)};${paletteVars(style)}`;
const cornerClass = complication?.corner ?? 'topRight';
---

<div class={`tank-frame tank-frame--${size} ${className}`}>
  <div
    class={`tank tank--${look}`}
    data-tank={JSON.stringify(config)}
    style={inline}
    role="img"
    aria-label={label ?? `A ${size} ${style.names.en} tank with ${fish.length} fish`}
  >
    {
      widget ? (
        <img class="tank__capture" src={widget.src} width={widget.attributes.width} height={widget.attributes.height} alt="" />
      ) : (
        <div class="tank__glass" aria-hidden="true" />
      )
    }
    <div class="tank__scene" aria-hidden="true"></div>
    {look === 'app' && <div class="tank__rim" aria-hidden="true" />}
    {complication && <div class={`tank__comp tank__comp--${cornerClass}`} data-kind={complication.kind} aria-hidden="true"></div>}
  </div>
</div>

<style is:global>
  .tank-frame {
    container-type: inline-size;
    width: 100%;
  }
  .tank {
    --u: calc(100cqw / var(--dw));
    position: relative;
    width: 100%;
    aspect-ratio: var(--dw) / var(--dh);
    border-radius: calc(var(--r, 28) * var(--u));
    overflow: hidden;
    isolation: isolate;
    /* keeps the compositor from re-rastering the glass on every fish move */
    transform: translateZ(0);
  }
  @supports (corner-shape: squircle) {
    .tank {
      border-radius: calc(var(--r, 28) * 1.357 * var(--u));
      corner-shape: superellipse(1.54);
    }
  }
  .tank__capture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* The app's GlassBackground, layer for layer: water, bloom, haze, inner shadow and glow */
  .tank__glass {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgb(var(--bed) / 0) 64%,
        rgb(var(--bed) / 0.12) 78%,
        rgb(var(--bed) / 0.45) 90%,
        rgb(var(--bed) / 0.85) 97%,
        rgb(var(--bed) / 1) 100%
      ),
      radial-gradient(calc(130 * var(--u)) at 15% 5%, rgb(255 255 255 / calc(0.28 * var(--hl))), transparent 100%),
      linear-gradient(to bottom, var(--w0) 0%, var(--w25) 25%, var(--w60) 60%, var(--w100) 100%);
    box-shadow:
      inset 0 0 calc(7 * var(--u)) calc(9 * var(--u)) rgb(var(--shadow) / var(--shadow-a)),
      inset 0 0 calc(2.5 * var(--u)) calc(3 * var(--u)) rgb(255 255 255 / calc(0.55 * var(--hl)));
  }
  /* the shine band across the top: light off the glass face */
  .tank__glass::before {
    content: "";
    position: absolute;
    left: calc(21 * var(--u));
    right: calc(21 * var(--u));
    top: calc(12 * var(--u));
    height: calc(16 * var(--u));
    border-radius: 999px;
    background: rgb(255 255 255 / calc(0.3 * var(--hl)));
    filter: blur(calc(4 * var(--u)));
  }
  .tank__rim {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    corner-shape: inherit;
    padding: 1.2px;
    background: linear-gradient(135deg, rgb(255 255 255 / 0.95), rgb(255 255 255 / 0.35) 55%, rgb(255 255 255 / 0.75));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
    z-index: 3;
  }
  .tank__scene {
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .tank__prop {
    position: absolute;
    display: block;
    pointer-events: none;
    user-select: none;
  }
  .tank__fish {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--g) * var(--u));
    height: calc(var(--g) * var(--u));
    will-change: transform;
    pointer-events: none;
    user-select: none;
    filter: drop-shadow(0 calc(1 * var(--u)) calc(2 * var(--u)) rgb(0 0 0 / 0.12));
  }
  .tank__bubble {
    position: absolute;
    left: 0;
    top: 0;
    width: 4px;
    height: 4px;
    opacity: 0;
    pointer-events: none;
    will-change: transform, opacity;
  }
  .tank__comp {
    position: absolute;
    z-index: 4;
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: calc(15 * var(--u));
    line-height: 1.1;
    text-shadow: 0 calc(1 * var(--u)) calc(2 * var(--u)) rgb(0 0 0 / 0.3);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    pointer-events: none;
  }
  .tank__comp--topLeft { left: calc(17 * var(--u)); top: calc(16 * var(--u)); }
  .tank__comp--topRight { right: calc(17 * var(--u)); top: calc(16 * var(--u)); }
  .tank__comp--bottomLeft { left: calc(17 * var(--u)); bottom: calc(13 * var(--u)); }
  .tank__comp--bottomRight { right: calc(17 * var(--u)); bottom: calc(13 * var(--u)); }
</style>

<script>
  import '../scripts/tank.js';
</script>
